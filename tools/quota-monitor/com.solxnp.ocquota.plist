<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.ocquota</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/solxnp/Applications/OCQuota.app/Contents/MacOS/OCQuota</string>
    </array>

    <!-- 登录时自动启动 -->
    <key>RunAtLoad</key>
    <true/>

    <!-- 崩溃后自动重启（被手动退出时不重启） -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- 只在图形会话中运行（菜单栏应用必须） -->
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <!-- 启动失败时退避重试，避免狂刷 -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/solxnp/Library/Logs/OCQuota.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/solxnp/Library/Logs/OCQuota.stderr.log</string>
</dict>
</plist>
